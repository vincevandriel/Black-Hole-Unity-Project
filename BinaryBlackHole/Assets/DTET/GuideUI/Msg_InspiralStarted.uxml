<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GuideStyles.uss" />
    <ui:Template name="GuidePopup" src="GuidePopup.uxml" />
    <ui:VisualElement name="inspiralStarted" class="guide-message-root" picking-mode="Ignore">
        <ui:Instance template="GuidePopup" name="popup" class="guide-no-title">
            <ui:AttributeOverrides element-name="bodyLabel" text="The inspiral has started" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
