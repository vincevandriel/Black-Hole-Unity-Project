<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GuideStyles.uss" />
    <ui:Template name="GuidePopup" src="GuidePopup.uxml" />
    <ui:VisualElement name="chirpNotPicture" class="guide-message-root" picking-mode="Ignore">
        <ui:Instance template="GuidePopup" name="popup" class="guide-warning">
            <ui:AttributeOverrides element-name="titleLabel" text="STAGE 5" />
            <ui:AttributeOverrides element-name="bodyLabel" text="Chirp: a detector-like signal, not a picture" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
