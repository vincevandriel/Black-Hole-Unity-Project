<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GuideStyles.uss" />
    <ui:Template name="GuidePopup" src="GuidePopup.uxml" />
    <ui:VisualElement name="rescaled" class="guide-message-root" picking-mode="Ignore">
        <ui:Instance template="GuidePopup" name="popup" class="guide-warning">
            <ui:AttributeOverrides element-name="titleLabel" text="NOTE" />
            <ui:AttributeOverrides element-name="bodyLabel" text="Sizes and distances are rescaled" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
