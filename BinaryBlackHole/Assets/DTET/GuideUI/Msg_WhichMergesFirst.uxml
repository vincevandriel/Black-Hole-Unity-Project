<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GuideStyles.uss" />
    <ui:Template name="GuidePopup" src="GuidePopup.uxml" />
    <ui:VisualElement name="whichMergesFirst" class="guide-message-root" picking-mode="Ignore">
        <ui:Instance template="GuidePopup" name="popup">
            <ui:AttributeOverrides element-name="titleLabel" text="TASK" />
            <ui:AttributeOverrides element-name="bodyLabel" text="Which system merges first, and why?" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
