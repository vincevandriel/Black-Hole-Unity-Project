# Generated Unity state (once the selected project is added).
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# Keep the portable staging projects, but ignore their build products.
!Staging/Simulation/*.csproj
!Staging/Simulation.Tests/*.csproj
!Staging/Fluid.RefinementAudit/*.csproj
!Staging/MiniDisk.Exporter/*.csproj
**/bin/
**/obj/
.vs/

# Local recordings, packaging receipts, and Python caches are not project source.
/output/
/outputs/
**/__pycache__/
*.pyc
*.pdb
*.mdb
**/*_BurstDebugInformation_DoNotShip/

# Temporary receipts generated by Unity's performance test package.
BinaryBlackHole/Assets/Resources/PerformanceTestRunInfo.json*
BinaryBlackHole/Assets/Resources/PerformanceTestRunSettings.json*
